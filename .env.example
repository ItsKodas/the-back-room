# Copy to .env and fill in. Everything here is optional: with none of it set the
# game runs exactly as it does today — guests type a name and play, with no
# database and no sign-in.
#
# Read by both `npm run dev` and the compose stack. The compose stack overrides
# MONGO_URL and CLIENT_ORIGIN, because inside its network the database answers
# to `mongo` and the server serves the client on its own port.

# --- Sign in with Discord ------------------------------------------------
# Create an application at https://discord.com/developers/applications, then
# under OAuth2 add a redirect URI matching DISCORD_REDIRECT_URI below.
# Without these two the auth routes answer 503 and the sign-in button is
# hidden rather than offered and broken.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# --- Persistence ---------------------------------------------------------
# Unset means profiles, chips and history live in memory and vanish on
# restart. The game still works; nothing is kept.
#
# The right value depends on where the server runs, because `localhost` is
# resolved by whoever is asking:
#
#   npm run dev            mongodb://127.0.0.1:27017/greed
#   docker compose         mongodb://host.docker.internal:27017/greed
#                          ...to reach a mongod on the same machine. A
#                          database on another host takes its real address
#                          either way.
#
# Getting this wrong is quiet rather than loud: the server reports that it
# could not reach the database and carries on in memory.
MONGO_URL=

# --- Sessions ------------------------------------------------------------
# Signs the session cookies, so this is what stands between a stranger and
# someone else's chips. In development it may be left empty and a fixed default
# is used; in production the server refuses to start without one, because the
# default is published in this repository and anyone could forge a cookie with
# it. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Who can mint chips --------------------------------------------------
# Discord user ids, comma separated. These people can reach /admin and mint
# redeemable codes. Left empty, nobody can — including whoever deployed this.
# There is no way to grant it from inside the product, by design: the only
# other way chips come into existence is the daily top-up.
ADMIN_DISCORD_IDS=

# --- Where things live ---------------------------------------------------
# CLIENT_ORIGIN is the address a player's browser is at, which is where they
# get sent back to after signing in. Only sign-in depends on it; guests never
# touch it.
#
# It differs between the two ways of running, and there is no single value that
# serves both:
#
#   npm run dev      http://localhost:5173     (Vite serves the client)
#   docker compose   http://localhost:3001     (the server serves it itself)
#
# Both `npm run dev` and the compose stack read this same file, so the value
# below is the one in use. Keep a second file for the other and point compose
# at it when you deploy — that switches every variable at once, credentials
# included, not just this one:
#
#   docker compose --env-file .env.production up --build
#
# Joining over the network wants that address instead of localhost, here and in
# DISCORD_REDIRECT_URI above — which also has to be registered in the Discord
# application. Discord accepts several redirect URIs, so every address you use
# can be listed there and this file decides which is in play.
#
# PORT is the server's own port, and the compose stack publishes it on the same
# number.
#
# BIND_ADDR is which address it publishes that port on, and it defaults to
# 127.0.0.1. Leave it alone when something sits in front of this (the same
# arrangement TRUST_PROXY is about): the proxy reaches the container on
# localhost. Set it to 0.0.0.0 only when you mean to reach the site directly
# from another machine, which also means reaching it around that proxy.
#
# TRUST_PROXY matters only when something sits in front terminating TLS —
# Cloudflare, nginx, a tunnel. Without it the server treats every request as
# insecure and refuses to send its session cookie, so signing in does nothing
# at all. Production assumes one proxy; set this when there are more, or to a
# specific address or subnet.
TRUST_PROXY=
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
BIND_ADDR=
