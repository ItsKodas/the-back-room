{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backroom",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "backroom-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "-w", "@backroom/server", "--", "--port", "3002"],
      "port": 3002,
      "autoPort": false
    },
    {
      "name": "backroom-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 3001,
      "autoPort": false
    }
  ]
}
